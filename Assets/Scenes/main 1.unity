  objectives:
  - id: gauntlet
    text: Find the magnetic gauntlet ([E] to pick it up)
  - id: tutorial
    text: Hold RIGHT-CLICK to pull the crate onto the plate, release to drop it
  - id: storage
    text: Clear the crates blocking the storage room (hold a crate + LEFT-CLICK to
      throw)
  - id: plate
    text: Put the heavy crate on the pressure plate in the main corridor
  - id: generator
    text: Turn on the generator
  - id: exit
    text: Escape through the exit
